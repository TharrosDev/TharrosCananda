# ---------------------------------------------------------------------------
# PUBLIC: NEXT_PUBLIC_* values are inlined into the browser bundle. Never put secrets here.
# ---------------------------------------------------------------------------

# Canonical site origin used by metadata, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://tharros.ca

# Optional privacy-conscious analytics endpoint (receives sendBeacon JSON). Events are not sent when empty.
NEXT_PUBLIC_ANALYTICS_ENDPOINT=

# Optional override for the public contact address. Defaults to the verified TharrosDev@gmail.com
# (src/lib/contact.ts), shown on About, Privacy, the request page, the footer and in JSON-LD.
NEXT_PUBLIC_RESEARCH_EMAIL=

# ---------------------------------------------------------------------------
# SERVER-ONLY SECRETS: read only in route handlers; never exposed to the browser.
# ---------------------------------------------------------------------------

# Webhook that receives validated research-intake JSON. Must be an https:// URL; anything else
# is treated as "not configured" and the form shows a generic delivery error (logged server-side).
# Rate limiting is a Vercel Firewall rule on POST /api/research-request (docs/PRE_LAUNCH.md).
RESEARCH_INTAKE_WEBHOOK_URL=

# Shared secret used to HMAC-sign webhook deliveries. Required for live intake; configure the receiver with the same value.
RESEARCH_INTAKE_WEBHOOK_SECRET=

# Currents News API key for /live-monitor. Server-only; sent in the Authorization: Bearer header.
# Never expose it through NEXT_PUBLIC_*, query parameters, logs or committed configuration.
CURRENTS_API_KEY=

# Test-only: point public-source adapters at the Playwright mock server. Leave unset in every deployment.
# STATCAN_WDS_BASE_URL=
# OPEN_DATA_BASE_URL=
# CURRENTS_API_BASE_URL=
