# Public canonical site origin used by metadata and sitemap generation.
NEXT_PUBLIC_SITE_URL=https://tharros.ca

# Optional privacy-conscious analytics endpoint. Events are not sent when empty.
NEXT_PUBLIC_ANALYTICS_ENDPOINT=

# Server-side webhook that receives validated research-intake JSON.
RESEARCH_INTAKE_WEBHOOK_URL=

# Displayed only when configured; no address is assumed in source code.
NEXT_PUBLIC_RESEARCH_EMAIL=
