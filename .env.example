# ---------------------------------------------------------------------------
# PUBLIC: NEXT_PUBLIC_* values are inlined into the browser bundle. Never put secrets here.
# ---------------------------------------------------------------------------

# Canonical site origin used by metadata, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://tharros.ca


# Optional override for the public contact address. Defaults to the verified TharrosDev@gmail.com
# (src/lib/contact.ts), shown on About, Privacy, the footer and in JSON-LD.
NEXT_PUBLIC_RESEARCH_EMAIL=

# ---------------------------------------------------------------------------
# SERVER-ONLY SECRETS: read only in route handlers; never exposed to the browser.
# ---------------------------------------------------------------------------

# Research readership counts (src/lib/metrics.ts). Without all three, nothing is counted or shown.
# Supabase project "tharros-canada"; migration in supabase/migrations. The service-role key never reaches the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Random secret (e.g. `openssl rand -hex 32`) that turns an IP into a per-publication reader code.
METRICS_SECRET=
